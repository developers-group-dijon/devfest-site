---
permalink: /schedule/
layout: page.njk
title: Le programme
image: "/background/sessions.webp"
css: "/css/schedule.css"
js: "/js/schedule-favorites.js"
eleventyComputed:
   description: Cette année, le {{ event.name }} se déroulera sur {{ tracks.length }} scènes de façon simultanée. Découvrez le programme et sélectionnez vos talks favoris pour créer votre programme sur mesure !
---

<style>
   {%- for day, daySlot in slots %}
   .grid-day.day_{{ day }} {
      grid-template-columns: [time] minmax(64px, 150px) {% for track in tracks %}[{{(tracks[loop.index0 - 1].id + "-end") if loop.index0 > 0 else "track" }} {{track.id}}] minmax(180px, 1fr) {% endfor %}[{{ tracks[tracks.length - 1].id }}-end track-end];
      grid-template-rows: [track] auto [tracksponsor] auto {% for slot in daySlot -%}[slot_{{ slot | dateKey }}] auto {% endfor -%}[end];
   }
   {%- endfor %}
</style>
<aside class="schedule-help full-width" data-help-key="schedule-favorites" hidden>
   <div class="schedule-help-icon">{% iconSvg 'solid/circle-info' %}</div>
   <div class="schedule-help-content">
      <span class="schedule-help-title">Composez votre planning personnel.</span><br>
      Cliquez sur le signet d'une session pour l'ajouter à vos favoris. Votre sélection est conservée dans ce navigateur.<br>
      Vous pouvez la partager via un lien depuis <a href="/favoris/">Mon planning</a>.
   </div>
   <button class="schedule-help-dismiss" type="button" aria-label="Masquer cette aide">×</button>
</aside>
{%- if event.sessionsDraft -%}
<div class="draft-warning full-width">
Le planning présenté est une version provisoire qui est susceptible d'évoluer.
</div>
{%- endif -%}
<details class="schedule-filters-collapse full-width">
   <summary>{% iconSvg 'solid/filter' %}<span>Filtrer le programme</span></summary>
   <div class="schedule-filters" role="search" aria-label="Filtres du programme">
      <fieldset class="filter-group">
         <legend>Format</legend>
         {%- for format in formats %}
         <button type="button" class="filter-chip" data-filter="format" data-value="{{ format.id }}" aria-pressed="false">{{ format.name }}</button>
         {%- endfor %}
      </fieldset>
      <fieldset class="filter-group">
         <legend>Catégorie</legend>
         {%- for category in categories %}
         <button type="button" class="filter-chip" data-filter="category" data-value="{{ category.id }}" aria-pressed="false">{{ category.name }}</button>
         {%- endfor %}
      </fieldset>
      <div class="filter-group filter-search">
         <label for="schedule-search">Recherche</label>
         <input id="schedule-search" type="search" placeholder="Titre, abstract, speaker…" autocomplete="off">
      </div>
      <button type="button" class="filter-reset" hidden>Réinitialiser</button>
      <p class="filter-empty" hidden role="status" aria-live="polite">Aucune session ne correspond à vos filtres.</p>
   </div>
</details>
<div class="schedule-page full-width">
   {%- for day, daySlot in slots %}
   <div class="day">
      <a href="#{{ day }}"><h2 class="date" id="{{ day }}">{{ day | dayFormat | capitalize }}</h2></a>
      <div class="grid-day day_{{ day }}">
         {%- for track in tracks %}
         <div class="track {{ track.id }}" style="grid-column: {{ track.id }}; grid-row: track">{{ track.name }}</div>
         {%- if track.sponsor -%}
         {%- set sponsor = sponsorsMap.get(track.sponsor) -%}
         <div class="tracksponsor {{ track.id }}" style="grid-column: {{ track.id }}; grid-row: tracksponsor">
            <a class="sponsor" href="{{ sponsor.website }}" aria-label="Site web de {{ sponsor.name }}" title="{{ sponsor.name }}"><img class="logo" src="{{ sponsor.logoUrl | normalizeAssetUrl }}" alt="Site web de {{ sponsor.name }}" loading="lazy" decoding="async"></a>
         </div>
         {%- endif -%}
         {%- endfor -%}
         {%- for slot in daySlot %}
         <div class="time" style="grid-column: time; grid-row: slot_{{ slot | dateKey }};">
            {%- set minutesAfterPrev = slot | minutesBetween(daySlot[loop.index0 - 1]) %}
            {%- if loop.first or  minutesAfterPrev > 5 -%}
            <span class="hours">{{ slot | hours }}</span>
            <span class="minutes">{{ slot | minutes }}</span>
            {%- endif -%}
         </div>
         {%- for session in sessions | filterByDateStart(slot) %}
            {%- set column = (session.trackRange[0]+" / "+session.trackRange[1]+"-end") if session.trackRange else (session.trackId | default ("track / -1")) %}
         <div class="{{ session.styleClass }} session" {% if not session.hideTrackTitle %}data-session-id="{{ session.id }}" data-format-id="{{ session.format.id }}" data-category-id="{{ session.category.id }}"{% endif %} style="grid-column: {{ column }} ; grid-row: slot_{{ session.dateStart | dateKey }} / span {{ session | countSlots(daySlot) }}">
            {%- if not session.hideTrackTitle %}
            <div class="session-actions-grid">
               {%- if session.feedbackUrl %}
               <a class="session-feedback" href="{{ session.feedbackUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Donner mon avis sur cette session" title="Donner mon avis">{% iconSvg 'regular/comment-dots' %}</a>
               {%- endif %}
               <button class="session-fav" type="button" aria-pressed="false" aria-label="Ajouter aux favoris" title="Ajouter aux favoris"><span class="star-off">{% iconSvg 'regular/bookmark' %}</span><span class="star-on">{% iconSvg 'solid/bookmark' %}</span></button>
            </div>
            {%- endif %}
            <div class="title">
               {%- if session.hideTrackTitle -%}
               {{ session.title }}
               {%- else -%}
               <a href="/session/{{ session.id | slugify }}">{{ session.title }}</a>
               {%- endif -%}
            </div>
            <div class="abstract">{{ session.abstract | md | safe | striptags | truncate(100) }}</div>
            <div class="extra">{{ session.durationMinutes }} minutes<span class="session-track">{%- for track in session.tracks %} ⋅ {{ track.name }}{%- endfor %}</span></div>
            {%- if session.level or session.category.name %}
            <div class="extra">{{ session.category.name }} ⋅ {{ session.level | formatLevel }} ⋅ {{ session.language | formatLanguage }}</div>
            {%- endif -%}
            {%- if session.speakers.length %}
            <div class="speakers">
               <div class="speaker-title">Speakers</div>
               {%- for speaker in session.speakers -%}
               <div class="speaker">
                  <span class="avatar-frame"><img class="avatar" src="{{ (speaker.photoUrl if speaker.photoUrl else '/default-avatar.webp') | normalizeAssetUrl }}" alt="" width="128" height="128" loading="lazy" decoding="async"></span>
                  <a class="speaker-name" href="/speaker/{{ speaker.name | slugify }}">{{ speaker.name }} ⋅ {{ speaker.company }}</a>
               </div>
               {%- endfor %}
            </div>
            {%- endif -%}
         </div>
         {%- endfor -%}
         {%- endfor -%}
      </div>
   </div>
   {%- endfor -%}
</div>
