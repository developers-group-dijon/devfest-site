---js
{
    pagination: {
        data: "speakers",
        size: 1,
        alias: "speaker",
    },
    permalink: "/speaker/{{ speaker.name | slugify }}/",
    layout: "page.njk",
    image: "/background/speakers.webp",
    css: "/css/speaker.css",
    eleventyComputed: {
        title: "{{ speaker.name }}",
        description: "{{ speaker.jobTitle }} {{ speaker.company }}",
        speakerSessions: function(data) { return (data.sessions || []).filter((s) => (s.speakerIds || []).includes(data.speaker.id)); },
        // Meta sociales : le nom du speaker seul, la bio tronquée comme description.
        // L'image OG hérite du logo de l'événement défini par défaut dans og-tags.njk.
        // og:type=profile permet aux lecteurs OG d'enrichir la carte (LinkedIn affiche
        // le nom comme contact).
        ogTitle: "{{ speaker.name }}",
        ogDescription: "{{ speaker.bio | excerpt(200) }}",
        ogType: "profile",
        ogProfileFirstName: function(data) { return (data.speaker.name || "").split(" ")[0] || ""; },
        ogProfileLastName: function(data) { return (data.speaker.name || "").split(" ").slice(1).join(" "); },
    },
}
---

<div class="main-content">
    <img class="avatar" src="{{ (speaker.photoUrl if speaker.photoUrl else '/default-avatar.webp') | normalizeAssetUrl }}" alt="" width="128" height="128" decoding="async">
    <div class="job_title">{{ speaker.bio | md | safe }}</div>
    <div class="socials">
        {%- for social in speaker.socials %}
        {% social social %}
        {%- endfor -%}
    </div>
</div>
<div class="aside">
    <div class="sessions">Sessions</div>
    <ul>
        {%- for session in speakerSessions %}
        <li><a class="session-name" href="/session/{{ session.id | slugify }}">{{ session.title }}</a></li>
        {%- endfor -%}
    </ul>
</div>
