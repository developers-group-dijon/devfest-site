---js
{
    pagination: {
        data: "rawSessions",
        size: 1,
        alias: "rawSession",
        before: function(paginationData, fullData) {
            return paginationData.filter(rawSession => rawSession.hideTrackTitle === false);
        },
    },
    permalink: "/session/{{ rawSession.id | slugify }}/",
    layout: "page.njk",
    image: "/background/sessions.webp",
    css: "/css/session.css",
    js: "/js/session-favorites.js",
    eleventyComputed: {
        title: "{{ rawSession.title | safe }}",
        // Les données calculées (eleventyComputed) ne sont pas disponibles dans la pagination.
        // On travaille donc sur les rawSessions qu'on "résoud" ici
        session: function(data) { return (data.sessions || []).find((s) => s.id === data.rawSession.id) },
        description: "{{ session.format.name }} ({{ session.durationMinutes }} minutes){{ (' ⋅ ' + session.category.name) if session.category.name }}{{ ' ⋅ ' + (session.level | formatLevel ) if session.level}}{{ ' ⋅ ' + (session.language | formatLanguage) if session.language }}\n{{ session.dateStart | shortDateFormat | capitalize }} à {{ session.dateStart | timeFormat }} ⋅ {{ session.tracks | mapName | join(', ') }}",
    },
}
---
<div class="main-content">
    <div class="session-actions">
        <button class="session-fav-large" type="button" aria-pressed="false" data-session-id="{{ rawSession.id }}" aria-label="Ajouter aux favoris"><span class="star-off">{% iconSvg 'regular/bookmark' %}</span><span class="star-on">{% iconSvg 'solid/bookmark' %}</span><span class="label">Ajouter aux favoris</span></button>
        {%- if session.feedbackUrl %}
        <a class="session-feedback-large" href="{{ session.feedbackUrl }}" target="_blank" rel="noopener">{% iconSvg 'regular/comment-dots' %}<span>Donner mon avis</span></a>
        {%- endif %}
    </div>
    {{ session.abstract | md | safe }}
</div>

<div class="aside">
    {%- for speaker in session.speakers %}
    <div class="speaker">
        <img class="avatar" src="{{ (speaker.photoUrl if speaker.photoUrl else '/default-avatar.webp') | normalizeAssetUrl }}" alt="" width="128" height="128" loading="lazy" decoding="async">
        <div><a class="speaker-name" href="/speaker/{{ speaker.name | slugify }}">{{ speaker.name }} ⋅ {{ speaker.company }}</a></div>
    </div>
    {%- endfor -%}
    {%- set concurrent = sessions | concurrentSessions(session) %}
    {%- if concurrent.length %}
    <section class="concurrent-sessions" aria-labelledby="concurrent-sessions-title">
        <h2 id="concurrent-sessions-title">En même temps</h2>
        {%- for other in concurrent %}
        <div class="concurrent-session">
            <button class="session-fav" type="button" aria-pressed="false" data-session-id="{{ other.id }}" aria-label="Ajouter aux favoris" title="Ajouter aux favoris"><span class="star-off">{% iconSvg 'regular/bookmark' %}</span><span class="star-on">{% iconSvg 'solid/bookmark' %}</span></button>
            <a class="concurrent-session-link" href="/session/{{ other.id | slugify }}">
                <div class="concurrent-session-meta">{{ other.dateStart | timeFormat }} ⋅ {{ other.tracks | mapName | join(', ') }}</div>
                <div class="concurrent-session-title">{{ other.title }}</div>
                {%- if other.speakers.length %}
                <div class="concurrent-session-speakers">
                    {%- for speaker in other.speakers -%}
                    {{ speaker.name }}{{ ', ' if not loop.last }}
                    {%- endfor -%}
                </div>
                {%- endif %}
            </a>
        </div>
        {%- endfor %}
    </section>
    {%- endif %}
</div>
