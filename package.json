{
  "name": "biblio-tech",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf _site",
    "build:eleventy": "ELEVENTY_PRODUCTION=true eleventy",
    "build:og": "node _scripts/generate-og.js",
    "check:prettier": "prettier --check .",
    "check:eslint": "run-p check:eslint:*",
    "check:eslint:run": "BROWSERSLIST_ENV=run eslint _assets/**/*.js",
    "check:eslint:build": "BROWSERSLIST_ENV=build eslint --ignore-pattern=_assets .",
    "check:stylelint": "BROWSERSLIST_ENV=run stylelint '_assets/**/*.css'",
    "check:jsdoc": "node_modules/.bin/tsc",
    "check:commit": "commitlint --to HEAD",
    "check:test": "TZ=Europe/Paris node --test _test/**/*.test.js",
    "check": "run-p check:*",
    "fix:prettier": "prettier --write .",
    "fix:eslint": "eslint --fix .",
    "fix:stylelint": "stylelint '_assets/**/*.css' --fix",
    "fix": "run-p fix:*",
    "build": "run-s build:eleventy build:og",
    "clean-build": "run-s clean build",
    "clean-serve-noinc": "run-s clean serve-noinc",
    "serve-noinc": "eleventy --serve",
    "serve": "eleventy --serve --incremental",
    "new-edition": "node _scripts/new-edition.js",
    "audit:perf": "node _audit/audit-perf.js",
    "audit:a11y": "start-server-and-test 'http-server _site -p 8088 -s -c-1' http://localhost:8088 'node _audit/audit-a11y.js'",
    "audit": "run-s build audit:perf audit:a11y"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/debug": "^4.1.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.2",
    "debug": "^4.4.3",
    "eslint": "^10.3.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.1.1",
    "node-html-parser": "^7.1.0",
    "npm-run-all": "^4.1.5",
    "pa11y": "^9.1.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "start-server-and-test": "^3.0.4",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/bitcount-grid-single": "^5.2.2",
    "@fontsource/noto-sans": "^5.2.10",
    "@fortawesome/fontawesome-free": "^7.2.0"
  }
}
